# --- MINECRAFT SERVER SETTINGS ---
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=AIAssistant
# Minecraft version (leave empty to let Mineflayer auto-detect from server)
MINECRAFT_VERSION=

# --- LOCAL AI (OLLAMA) SETTINGS ---
OLLAMA_BASE_URL=http://localhost:11434
# Recommended models: qwen2.5:3b (fast, lightweight), qwen2.5:7b, llama3.1:8b
OLLAMA_MODEL=qwen2.5:3b

# --- WEBSOCKET BRIDGE SETTINGS ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# --- BOT TEAMMATE BEHAVIOR ---
BOT_NAME=AIAssistant
# The player username the bot will protect, follow, and team up with
BOT_OWNER=Omer
LOG_LEVEL=INFO
