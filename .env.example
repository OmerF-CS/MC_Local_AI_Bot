# --- KÖPRÜ (BRIDGE) AYARLARI ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# --- BOT DAVRANIŞ AYARLARI ---
BOT_NAME=AIAssistant
# Botun sadakatle dinleyeceği ana oyuncu/sahip kullanıcı adı
